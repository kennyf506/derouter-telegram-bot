# 複製成 .env 後填入實際值。切勿把填好的 .env 提交進版控。

# --- 必填 ---
TELEGRAM_BOT_TOKEN=        # Telegram bot token（BotFather 取得）
DEROUTER_MGMT_KEY=         # DeRouter management key（sk-mgr-...），需啟用 usage 與帳號管理權限
DEROUTER_CHAT_ID=          # 接收推播的 Telegram 使用者 ID

# --- 收益推播（選填，留空用預設）---
DEROUTER_ALERT_STEP=1              # 當日收益每跨過多少美元提醒一次
DEROUTER_DAILY_HOUR=8              # 每天幾點送總結（台北時間 0-23）
DEROUTER_BILLING_START=2026-08-03  # 第一期起始日，之後每月同日自動滾動
# 月成本依帳號方案與數量自動計算，見 costs.js；不需設定 DEROUTER_MONTHLY_COST
DEROUTER_DAILY_COST=7              # 僅作為 GOAL_TARGETS 的預設來源；
                                   # 報告的日成本已改為 月成本 ÷ 本期天數 自動計算
DEROUTER_GOAL_TARGETS=7,14         # 每日達標門檻（美元，逗號分隔）

# --- /derouter 鏈上備援（選填）---
DEROUTER_WALLET=                  # 接收結算的 Solana 錢包；留空時由帳號清單首次探索並快取
DEROUTER_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
DEROUTER_CHAIN_MAX_TRANSACTIONS=10  # 每輪背景同步處理交易數（1–100）；每 30 秒一輪，限流自動退避

# --- 自動調速（選填）---
DISPATCH_ENABLED=          # 是否啟用排程調速
DISPATCH_KENNY_EMAIL=      # 調速目標帳號
